{
  "dataset_name": "Threshold Enterprise Knowledge Base",
  "company": "Threshold Enterprise Systems",
  "version": "1.0",
  "schema": {
    "description": "Enterprise document registry schema for Phase 2 document population and RAG ingestion.",
    "supported_fields": [
      "document_id",
      "title",
      "department",
      "classification",
      "version",
      "status",
      "effective_date",
      "allowed_roles",
      "document_type",
      "summary",
      "keywords",
      "file_path",
      "file_format"
    ],
    "field_specifications": {
      "document_id": {
        "type": "string",
        "example": "HR-001",
        "description": "Unique enterprise document identifier following <DEPT_CODE>-<NUMBER> format."
      },
      "title": {
        "type": "string",
        "example": "Employee Handbook",
        "description": "Official title of the document."
      },
      "department": {
        "type": "string",
        "example": "Human Resources",
        "description": "Owner department name as defined in department_definitions.json."
      },
      "classification": {
        "type": "string",
        "enum": [
          "PUBLIC",
          "INTERNAL",
          "CONFIDENTIAL",
          "RESTRICTED"
        ],
        "example": "INTERNAL",
        "description": "Sensitivity classification level determining access controls."
      },
      "version": {
        "type": "string",
        "example": "1.0",
        "description": "Semantic version identifier."
      },
      "status": {
        "type": "string",
        "enum": [
          "DRAFT",
          "ACTIVE",
          "ARCHIVED",
          "SUPERSEDED"
        ],
        "example": "ACTIVE",
        "description": "Lifecycle status governing retrieval prioritization."
      },
      "effective_date": {
        "type": "string",
        "format": "date (YYYY-MM-DD)",
        "example": "2026-01-15",
        "description": "Official date when the document became effective."
      },
      "allowed_roles": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "EMPLOYEE",
            "MANAGER",
            "ENGINEER",
            "AI_ENGINEER",
            "SECURITY_ENGINEER",
            "OPERATIONS_MANAGER",
            "HR_MANAGER",
            "ADMIN"
          ]
        },
        "description": "List of user roles authorized to view or retrieve the document."
      },
      "document_type": {
        "type": "string",
        "enum": [
          "POLICY",
          "STANDARD",
          "GUIDELINE",
          "PROCEDURE",
          "RUNBOOK",
          "HANDBOOK",
          "FRAMEWORK",
          "PLAYBOOK"
        ],
        "example": "HANDBOOK",
        "description": "Standardized document type defining its structure and purpose."
      },
      "summary": {
        "type": "string",
        "example": "Comprehensive organizational handbook...",
        "description": "Concise summary used for metadata indexing and semantic search pre-filtering."
      },
      "keywords": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "example": [
          "employee handbook",
          "workplace culture"
        ],
        "description": "High-signal search keywords for hybrid BM25 and lexical retrieval."
      },
      "file_path": {
        "type": "string",
        "example": "source_documents/hr/employee_handbook.docx",
        "description": "Relative path to source document file from dataset root."
      },
      "file_format": {
        "type": "string",
        "example": "docx",
        "description": "File format identifier (docx, pdf, txt)."
      }
    }
  },
