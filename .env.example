# Copy to .env for local development. Never commit .env or real credentials.
ENVIRONMENT=development
DEBUG=false
ENABLE_DOCS=true
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-distinct-long-random-secret
DATABASE_URL=sqlite+aiosqlite:///THRESHOLD.db
SYNC_DATABASE_URL=sqlite:///THRESHOLD.db
GEMINI_API_KEY=
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_PATH=data/vector_store
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
METRICS_ENABLED=true
RAI_ENABLED=true
RAI_INJECTION_DETECTION_ENABLED=true
